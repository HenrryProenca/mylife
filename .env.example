# ============================================================================
# MyLife — Variáveis de ambiente
# ============================================================================
# Copie este arquivo para `.env.local` e preencha com os valores do seu
# projeto Supabase (Settings → API).
#
# ATENÇÃO:
# - Tudo que começa com VITE_ vai para o bundle do frontend (é público).
# - NUNCA coloque aqui a SERVICE_ROLE_KEY nem senha de banco.
#   Essas chaves só podem ser usadas em ambiente de servidor.
# ============================================================================

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=COLE_AQUI_A_ANON_KEY

# Nome exibido na interface (opcional)
VITE_APP_NAME=MyLife